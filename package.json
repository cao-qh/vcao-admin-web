{
  "name": "vue-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check-node-version": "node -e \"const semver = require('semver'); const { engines } = require('./package.json'); const version = process.version; if (!semver.satisfies(version, engines.node)) { console.error(`Node.js version ${version} does not satisfy the required version ${engines.node}`); process.exit(1); }\"",
    "dev": "npm run check-node-version && vite --host",
    "build": "npm run check-node-version && run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@tsparticles/slim": "^3.5.0",
    "@tsparticles/vue3": "^3.0.1",
    "ant-design-vue": "4.x",
    "axios": "^1.6.7",
    "dayjs": "^1.11.10",
    "nprogress": "^0.2.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.15",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.23.10",
    "@tsconfig/node20": "^20.1.2",
    "@types/node": "^20.11.10",
    "@types/nprogress": "^0.2.3",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "@vitejs/plugin-vue": "^5.0.3",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-vue": "^9.22.0",
    "mockjs": "^1.1.0",
    "npm-run-all2": "^6.1.1",
    "postcss": "^8.4.35",
    "postcss-html": "^1.6.0",
    "prettier": "^3.2.5",
    "semver": "^7.6.3",
    "typescript": "~5.3.0",
    "vite": "^5.0.11",
    "vite-plugin-mock": "^3.0.1",
    "vite-plugin-svg-icons": "^2.0.1",
    "vue-tsc": "^1.8.27"
  },
  "engines": {
    "node": ">20.0.0"
  }
}
